# Sistema
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDEs
.vscode/
.idea/
*.sublime-*

# Python
__pycache__/
*.pyc
*.pyo

# Build y deployment
dist/
build/

# Previsualización local del sitio combinado: docker-compose monta la guía en
# /documentacion/, y quien previsualiza sin Docker suele crear este symlink a
# mano. No puede entrar en el repositorio: `cp -r docs/* dist/` lo copiaría al
# artefacto y dejaría un enlace colgante en producción.
docs/documentacion

# Capa documental (documentacion/): Astro y originales.
# documentacion/.gitignore ya cubre esto; se repite aquí a propósito, porque
# un PDF con datos personales no puede depender de un solo fichero de reglas.
documentacion/node_modules/
documentacion/.astro/
private-sources/

# WhatsApp
*.zip
*.mp4

# Misc
*.log

# OpenCode / Agent runtime (mantener versionados .agents/skills y opencode.jsonc)
skills-lock.json
.opencode/
.opencode-cache/
.agents/cache/
.agents/tmp/
.agents/.cache/
