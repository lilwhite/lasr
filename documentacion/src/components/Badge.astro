---
import type { BadgeTone } from '../lib/policy';

interface Props {
  label: string;
  tone?: BadgeTone;
}
const { label, tone = 'neutral' } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`]}>{label}</span>

<style>
  .badge {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.14rem 0.5rem;
    border-radius: 999px;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  /* El filete se deriva del tono de cada insignia en lugar de fijarse en hex:
     así sigue al tema oscuro en vez de quedarse claro sobre fondo oscuro. */
  .badge--neutral { background: var(--stamp-soft); color: var(--info); border-color: color-mix(in srgb, var(--info) 30%, var(--surface)); }
  .badge--info { background: var(--info-bg); color: var(--info); border-color: color-mix(in srgb, var(--info) 30%, var(--surface)); }
  .badge--ok { background: var(--ok-bg); color: var(--ok); border-color: color-mix(in srgb, var(--ok) 30%, var(--surface)); }
  .badge--warn { background: var(--warn-bg); color: var(--warn); border-color: color-mix(in srgb, var(--warn) 30%, var(--surface)); }
  .badge--alert { background: var(--alert-bg); color: var(--alert); border-color: color-mix(in srgb, var(--alert) 30%, var(--surface)); }
</style>
