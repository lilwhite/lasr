---
import Layout from '../layouts/Layout.astro';
import { published } from '../lib/policy';
import Timeline from '../components/Timeline.astro';
---
<Layout title="Cronología" description="Qué ha ocurrido en Los Ángeles de San Rafael desde 1966: sentencias, juntas, acuerdos y actos administrativos, cada uno con su documentación.">
  <header class="head">
    <h1>Cronología</h1>
    <p class="lede">Los {published.events.length} acontecimientos documentados, de 1966 a hoy. Toca cualquiera para ver qué ocurrió y de dónde lo sabemos.</p>
  </header>
  <Timeline events={published.events} groupBy="decade" />
</Layout>

<style>
  .head { max-width: var(--measure); margin-bottom: var(--s-5); }
  .head h1 { margin-bottom: var(--s-3); }
</style>
