---
import { resolve, entityRoute, entityLabel } from '../lib/graph';
import { isVisible } from '../lib/policy';

interface Props {
  id: string;
  /** Texto alternativo; por defecto, la etiqueta de la entidad. */
  label?: string;
}
const { id, label } = Astro.props;
const entry = resolve(id);
const visible = isVisible(entry);
const text = label ?? entityLabel(entry);
---

{visible ? (
  <a href={entityRoute(entry)}>{text}</a>
) : (
  <span class="unpublished" title="Contenido no publicado">{text}</span>
)}

<style>
  .unpublished { color: var(--ink-soft); }
</style>
