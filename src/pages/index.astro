---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { graph, entityRoute } from '../lib/graph';
import { visibleOnly } from '../lib/policy';

const topics = visibleOnly(graph.topics);
const nSources = graph.sources.length;
const nNotes = graph.notes.length;
---

<Layout
  title="Inicio"
  description="Capa de conocimiento documental sobre Los Ángeles de San Rafael: sentencias, acuerdos y documentos, con cada afirmación trazada a su fuente."
>
  <p class="eyebrow">Los Ángeles de San Rafael · El Espinar (Segovia)</p>
  <h1>Entender la urbanización, documento a documento</h1>
  <p>
    LASR‑Web reconstruye la historia jurídica y administrativa de Los Ángeles de San Rafael a
    partir de documentación primaria: sentencias, autos, estatutos, actas y acuerdos. No es un
    archivo de PDFs: cada afirmación publicada indica de qué documento sale y en qué página, para
    que cualquier vecino pueda comprobarla.
  </p>

  <h2>Temas</h2>
  {topics.map((t) => (
    <Card>
      <h3 style="margin-top:0"><a href={entityRoute(t)}>{t.data.title}</a></h3>
      <p class="muted">{t.data.summary}</p>
    </Card>
  ))}

  <p class="muted">
    Corpus actual: {nSources} documentos con ficha y {nNotes} afirmaciones extraídas, en fase de
    revisión. El proyecto está en construcción.
  </p>
</Layout>
